# The pipeline's settings for this project. None is a secret. Read by .github/workflows/release.yml.
# Printed by fleet's pipelines/cloud-run/setup.sh; change a value here, in a pull request.
GCP_PROJECT=webmoderne-dev
GCP_REGION=europe-west1
SERVICE=devis-3-minutes
IMAGE_STORE=devis-3-minutes
WIF_PROVIDER=projects/101251110413/locations/global/workloadIdentityPools/github/providers/github
RELEASE_IDENTITY=devis-3-minutes-release@webmoderne-dev.iam.gserviceaccount.com
RUN_IDENTITY=devis-3-minutes-run@webmoderne-dev.iam.gserviceaccount.com
# The project's own checks, run on every pull request and every change of main (.github/workflows/checks.yml):
# its tests, its lint. One command line; empty runs none, and says so.
# tests/page.js, tests/pdf.js and tests/trajet.js need Chrome (and pdftotext): not run here.
CHECK_COMMAND=node --test tests/calc.test.js tests/depot.test.js
# The page that names the commit, then the pages the check must find answering, separated by spaces.
VERSION_PATH=/version
CHECK_PATHS=/ /app.js /settings
MEMORY=256Mi
MAX_INSTANCES=2
# The address the visitors use: a domain of yours, or the service's own (setup.sh prints it). The watch
# reads it from outside, like a visitor.
PUBLIC_ADDRESS=https://devis-3-minutes-kilk5q2ieq-ew.a.run.app
# The watch: how long a release is watched right after it is opened (failing twice in a row, the visitors go
# back by themselves), and for how long after an opening the scheduled watch still goes back by itself.
WATCH_MINUTES=2
GO_BACK_WITHIN_MINUTES=120
# What this product needs beyond the standard. In any value, {commit}, {address} and {time} are filled in.
#   BUILD_<NAME>=value    given to the build as the build argument <NAME>. Public values only: they end in the image.
#   SET_<NAME>=value      a plain setting the service starts with, as <NAME>. Never a secret.
#   READS=NAME=secret-name OTHER=other-secret    what the service reads from Secret Manager, by name.
BUILD_SITE_ADDRESS={address}
# What must not be in the repository (a key every browser receives, an address, an id): write the same BUILD_
# and SET_ lines in one secret of Secret Manager, and name that secret here. Its lines join these.
PRIVATE_SETTINGS=devis-private-settings
# The SET_ lines are the whole list of plain settings, and READS the whole list of secrets: what is no longer
# written here is removed at the next release. With no SET_ line, the plain settings stay as they are; with
# an empty READS, the secrets stay as they are.
READS=TRIAL_SECRET=devis-trial-secret
# The nightly cleanup (.github/workflows/cleanup.yml): how many released images stay beside the ones in use,
# and after how many days without a commit a preview is removed.
KEEP_IMAGES=3
PREVIEW_DAYS=7
# Previews, one per pull request (.github/workflows/preview.yml). They live apart from the released service:
# another service, another image store, other identities, and usually another Google Cloud project.
PREVIEW_PROJECT=webmoderne-dev
PREVIEW_SERVICE=devis-3-minutes-preview
PREVIEW_IMAGE_STORE=devis-3-minutes-preview
PREVIEW_WIF_PROVIDER=projects/101251110413/locations/global/workloadIdentityPools/github/providers/github
PREVIEW_IDENTITY=devis-3-minutes-preview@webmoderne-dev.iam.gserviceaccount.com
PREVIEW_RUN_IDENTITY=devis-3-minutes-preview-run@webmoderne-dev.iam.gserviceaccount.com
# The same three, for previews: PREVIEW_BUILD_<NAME>, PREVIEW_SET_<NAME>, PREVIEW_READS.
PREVIEW_BUILD_SITE_ADDRESS={address}
PREVIEW_READS=TRIAL_SECRET=devis-trial-secret
# The previews' settings kept out of the repository: a secret of the previews' project, same BUILD_ and SET_ lines.
PREVIEW_PRIVATE_SETTINGS=devis-preview-private-settings
